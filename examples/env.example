# Copy to private/.env — never commit this file.
ANTHROPIC_API_KEY=
# Only if your key isn't scoped to a workspace (console.anthropic.com → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=
# How the bot texts: "messages" (the Mac's Messages app: iMessage, plus SMS through an iPhone) or "whatsapp"
TRANSPORT=messages
# Optional: exact name of a family group chat to post "announce" to. Leave empty to text everyone individually.
GROUP_NAME=
# WhatsApp only: the spare number the bot runs on, digits with country code
WA_BOT_PHONE=
HOLIDAY=thanksgiving
YEAR=2026
