# Copy to private/.env — never commit this file.
ANTHROPIC_API_KEY=
# Only if your key isn't scoped to a workspace (console.anthropic.com → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=
# The spare WhatsApp number the bot runs on, digits with country code
WA_BOT_PHONE=
# Exact name of the family WhatsApp group (the bot's number must be a member)
WA_GROUP_NAME=
HOLIDAY=thanksgiving
YEAR=2026
